# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force specific line endings for shell scripts and batch files
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
