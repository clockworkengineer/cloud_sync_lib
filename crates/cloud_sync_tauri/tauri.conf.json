{
  "productName": "Cloud Sync",
  "version": "0.2.0",
  "identifier": "com.cloudsync.app",
  "build": {
    "frontendDist": "dist"
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cloud_sync_daemon"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Cloud Sync Dashboard",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  }
}
